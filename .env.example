# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# Gold market data provider selection:
# - "goldprice.dev": Official goldprice.dev Commodity & Karat API (XAU/USD, live FX, /v1/carat, /v1/bars)
# - "realtime": Global spot market aggregator (COMEX GC=F & LBMA PAXG)
# - "goldapi": Direct GoldAPI.io integration (requires GOLD_API_KEY)
# - "mock": Offline mock provider for testing (clearly tagged DEMO DATA)
GOLD_API_PROVIDER="goldprice.dev"

# goldprice.dev API key (Bearer ga_live_*):
# Optional for basic/free usage (5,000 calls/mo, 10 req/min). Add key for higher limits and full depth.
GOLDPRICE_DEV_API_KEY=""

# Optional secondary provider keys:
GOLD_API_KEY=""
FX_API_KEY=""

# Cache & refresh configuration
CACHE_TTL_SECONDS=10
